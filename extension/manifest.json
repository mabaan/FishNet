{
  "manifest_version": 3,
  "name": "Phishing URL Detector",
  "version": "1.0.0",
  "description": "Detects phishing URLs using URL similarity and ML classification",
  "permissions": [
    "activeTab",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "public/icons/FishNet Icon.png",
      "48": "public/icons/FishNet Icon.png",
      "128": "public/icons/FishNet Icon.png"
    }
  },
  "icons": {
    "16": "public/icons/FishNet Icon.png",
    "48": "public/icons/FishNet Icon.png",
    "128": "public/icons/FishNet Icon.png"
  }
}